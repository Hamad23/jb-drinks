rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function owner() {
      return verified() && request.auth.token.email == 'hamad293742@gmail.com';
    }

    function allowed() {
      return owner() || (
        verified() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
      );
    }

    function canAccessData() {
      return allowed();
    }

    match /allowedUsers/{allowedEmail} {
      allow get: if owner() || (
        verified() && request.auth.token.email == allowedEmail
      );
      allow create, update: if owner()
        && request.resource.data.email == allowedEmail;
      allow delete: if owner();
    }

    match /products/{productId} {
      allow read, create, update, delete: if canAccessData();
    }

    match /sales/{saleId} {
      allow read, create, update, delete: if canAccessData();
    }

    match /udhar/{entryId} {
      allow read, create, update, delete: if canAccessData();
    }

    match /expenses/{expenseId} {
      allow read, create, update, delete: if canAccessData();
    }

    match /migrations/{migrationId} {
      allow get: if canAccessData() && migrationId == 'legacy-local-v3';
      allow create, update: if canAccessData()
        && migrationId == 'legacy-local-v3'
        && request.resource.data.version is string;
      allow delete: if false;
    }
  }
}
